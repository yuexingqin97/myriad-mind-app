{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri-schema/refs/heads/master/schema.json",
  "productName": "myriad-mind-desktop",
  "version": "0.1.0",
  "identifier": "com.myriad-mind.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "大衍决 · 神识一扫，万物皆可为笔记",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../../scripts/*.py"
    ]
  }
}
